{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.28/MicrosoftTeams.schema.json",
  "manifestVersion": "1.28",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "developer": {
    "name": "OGE Refining Case App",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": {
    "short": "OGE Refining Cases",
    "full": "OGE Refining Case Content for Copilot Cowork"
  },
  "description": {
    "short": "Search and retrieve refinery case reports.",
    "full": "Search, filter, and retrieve read-only refinery case reports and timelines from the OGE Refining Case App."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#17324D",
  "agentConnectors": [
    {
      "id": "oge-refining-case-content",
      "displayName": "Refinery Cases",
      "description": "Search and retrieve refinery case reports and timelines.",
      "toolSource": {
        "remoteMcpServer": {
          "mcpServerUrl": "https://example.com/mcp",
          "mcpToolDescription": {
            "file": "./tools/case-app-tools.json"
          },
          "authorization": {
            "type": "OAuthPluginVault",
            "referenceId": "REPLACE-WITH-OAUTH-CONFIGURATION-ID"
          }
        }
      }
    }
  ]
}
