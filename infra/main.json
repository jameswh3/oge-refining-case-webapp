{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "12823432879611192541"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "northcentralus",
      "metadata": {
        "description": "Primary Azure region for App Service, SQL, identity, and monitoring."
      }
    },
    "staticWebAppLocation": {
      "type": "string",
      "defaultValue": "eastus2",
      "metadata": {
        "description": "Static Web Apps region. East US 2 supports Microsoft.Web/staticSites."
      }
    },
    "entraAdminObjectId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Entra object ID of the user who bootstraps Azure SQL."
      }
    },
    "entraAdminName": {
      "type": "string",
      "metadata": {
        "description": "Display name or UPN of the Azure SQL Entra administrator."
      }
    },
    "tenantId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Entra tenant ID."
      }
    },
    "apiClientId": {
      "type": "string",
      "metadata": {
        "description": "Case API application registration client ID."
      }
    }
  },
  "variables": {
    "suffix": "[uniqueString(subscription().id, resourceGroup().name)]",
    "apiName": "[format('oge-refining-case-api-{0}', variables('suffix'))]",
    "planName": "[format('oge-refining-case-plan-{0}', variables('suffix'))]",
    "identityName": "[format('oge-refining-case-api-id-{0}', variables('suffix'))]",
    "sqlName": "[format('ogerefiningcase{0}', variables('suffix'))]",
    "databaseName": "OgeRefiningCases",
    "staticWebAppName": "[format('oge-refining-case-web-{0}', variables('suffix'))]",
    "workspaceName": "[format('oge-refining-case-logs-{0}', variables('suffix'))]",
    "insightsName": "[format('oge-refining-case-insights-{0}', variables('suffix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('identityName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('workspaceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "retentionInDays": 30,
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true
        }
      },
      "sku": {
        "name": "PerGB2018"
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('insightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "kind": "app",
      "sku": {
        "name": "F1",
        "tier": "Free",
        "capacity": 1
      },
      "properties": {}
    },
    {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2023-12-01",
      "name": "[variables('staticWebAppName')]",
      "location": "[parameters('staticWebAppLocation')]",
      "sku": {
        "name": "Free",
        "tier": "Free"
      },
      "properties": {
        "allowConfigFileUpdates": true
      }
    },
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-08-01",
      "name": "[variables('sqlName')]",
      "location": "[parameters('location')]",
      "properties": {
        "minimalTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled",
        "restrictOutboundNetworkAccess": "Disabled",
        "version": "12.0",
        "administrators": {
          "administratorType": "ActiveDirectory",
          "principalType": "User",
          "login": "[parameters('entraAdminName')]",
          "sid": "[parameters('entraAdminObjectId')]",
          "tenantId": "[parameters('tenantId')]",
          "azureADOnlyAuthentication": true
        }
      }
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', variables('sqlName'), variables('databaseName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic",
        "tier": "Basic",
        "capacity": 5
      },
      "properties": {
        "maxSizeBytes": 2147483648,
        "zoneRedundant": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('apiName')]",
      "location": "[parameters('location')]",
      "kind": "app",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')))]": {}
        }
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "publicNetworkAccess": "Enabled",
        "clientAffinityEnabled": false,
        "siteConfig": {
          "alwaysOn": false,
          "ftpsState": "Disabled",
          "http20Enabled": true,
          "netFrameworkVersion": "v8.0",
          "minimumElasticInstanceCount": 0,
          "healthCheckPath": "/api/v1/health",
          "appSettings": [
            {
              "name": "ASPNETCORE_ENVIRONMENT",
              "value": "Production"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "1"
            },
            {
              "name": "Authentication__Enabled",
              "value": "true"
            },
            {
              "name": "Authentication__TenantId",
              "value": "[parameters('tenantId')]"
            },
            {
              "name": "Authentication__ClientId",
              "value": "[parameters('apiClientId')]"
            },
            {
              "name": "Authentication__Audience",
              "value": "[format('api://{0}', parameters('apiClientId'))]"
            },
            {
              "name": "Authentication__RequiredScope",
              "value": "case.read"
            },
            {
              "name": "Database__Provider",
              "value": "SqlServer"
            },
            {
              "name": "ConnectionStrings__Cases",
              "value": "[format('Server=tcp:{0},1433;Initial Catalog={1};Authentication=Active Directory Managed Identity;User Id={2};Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;', reference(resourceId('Microsoft.Sql/servers', variables('sqlName')), '2023-08-01').fullyQualifiedDomainName, variables('databaseName'), reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').clientId)]"
            },
            {
              "name": "Obo__TenantId",
              "value": "[parameters('tenantId')]"
            },
            {
              "name": "Obo__ClientId",
              "value": "[parameters('apiClientId')]"
            },
            {
              "name": "Obo__ManagedIdentityClientId",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').clientId]"
            },
            {
              "name": "Obo__GraphScope",
              "value": "https://graph.microsoft.com/.default"
            },
            {
              "name": "Cors__AllowedOrigins__0",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', variables('staticWebAppName')), '2023-12-01').defaultHostname)]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('insightsName')), '2020-02-02').ConnectionString]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]",
        "[resourceId('Microsoft.Insights/components', variables('insightsName'))]",
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "[resourceId('Microsoft.Sql/servers', variables('sqlName'))]",
        "[resourceId('Microsoft.Web/staticSites', variables('staticWebAppName'))]"
      ]
    }
  ],
  "outputs": {
    "apiAppName": {
      "type": "string",
      "value": "[variables('apiName')]"
    },
    "apiUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('apiName')), '2023-12-01').defaultHostName)]"
    },
    "managedIdentityName": {
      "type": "string",
      "value": "[variables('identityName')]"
    },
    "managedIdentityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').clientId]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]"
    },
    "sqlServerName": {
      "type": "string",
      "value": "[variables('sqlName')]"
    },
    "sqlServerFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Sql/servers', variables('sqlName')), '2023-08-01').fullyQualifiedDomainName]"
    },
    "sqlDatabaseName": {
      "type": "string",
      "value": "[variables('databaseName')]"
    },
    "staticWebAppName": {
      "type": "string",
      "value": "[variables('staticWebAppName')]"
    },
    "staticWebAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', variables('staticWebAppName')), '2023-12-01').defaultHostname)]"
    }
  }
}