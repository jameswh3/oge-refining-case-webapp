# Azure deployment target
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_LOCATION=your-primary-region
AZURE_STATIC_WEB_APP_LOCATION=your-static-web-app-region
# Optional when az.cmd is not available on PATH
AZURE_CLI_PATH=

# Microsoft Entra application registrations
ENTRA_TENANT_ID=your-tenant-id
ENTRA_API_CLIENT_ID=your-api-client-id
ENTRA_API_APP_OBJECT_ID=your-api-application-object-id
ENTRA_API_SCOPE=api://your-api-client-id/case.read
ENTRA_SPA_CLIENT_ID=your-spa-client-id
ENTRA_SPA_APP_OBJECT_ID=your-spa-application-object-id

# Azure SQL deployment administrator
ENTRA_ADMIN_OBJECT_ID=your-administrator-object-id
ENTRA_ADMIN_NAME=your-administrator-display-name-or-upn

# Copilot Studio
COPILOT_STUDIO_ENVIRONMENT_ID=your-copilot-studio-environment-id
COPILOT_STUDIO_SCHEMA_NAME=your-copilot-studio-schema-name

# Microsoft Foundry broker connection used when building the SPA
BROKER_BASE_URL=https://your-broker-host
BROKER_CLIENT_ID=your-broker-app-client-id
FOUNDRY_BROKER_RESOURCE_GROUP=your-foundry-broker-resource-group
FOUNDRY_RESOURCE_GROUP=your-existing-foundry-resource-group
FOUNDRY_ACCOUNT_NAME=your-existing-foundry-account-name
FOUNDRY_MODEL_DEPLOYMENT=your-model-deployment

# Local and deployed endpoints
LOCAL_API_BASE_URL=http://localhost:5016
LOCAL_SPA_BASE_URL=http://localhost:5173
LOCAL_MCP_SERVER_URL=http://localhost:5016/mcp
API_BASE_URL=https://your-api-host
MCP_SERVER_URL=https://your-api-host/mcp
MCP_AUTHORIZATION_SERVER=https://login.microsoftonline.com/your-tenant-id/v2.0
GRAPH_SCOPE=https://graph.microsoft.com/.default

# Values created while packaging a Copilot Cowork plugin
COWORK_OAUTH_CLIENT_ID=your-cowork-oauth-client-id
COWORK_OAUTH_REFERENCE_ID=your-plugin-vault-reference-id
COWORK_OAUTH_REDIRECT_URI=your-plugin-vault-redirect-uri
OAUTH_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/your-tenant-id/oauth2/v2.0/authorize
OAUTH_TOKEN_ENDPOINT=https://login.microsoftonline.com/your-tenant-id/oauth2/v2.0/token

# Deployment output; populate only when a known managed identity is referenced externally
AZURE_MANAGED_IDENTITY_CLIENT_ID=your-managed-identity-client-id
